DB_HOST=xxx         # IP ของ NodeJS-Server สำหรับเก็บข้อมูลจาก NodeJS-Client
DB_USER=xxx         # User ที่มีสิทธิ์เต็มของฐาน NodeJS-Server
DB_PASSWORD=xxx     # รหัสผ่านของ User
DB_NAME=xxx         # ชื่อฐานข้อมูล NodeJS-Server
DB_PORT=3306        # Port ของฐาน NodeJS-Server
PORT=3000           # Port สำหรับติดต่อกับ NodeJS-Client และ API

# =========================
# PHP API endpoint (คืน SQL จาก save_query)
# =========================
PHP_API_URL=http://xxx.xxx.xxx.xxx/script/get_query.php     # URL สำหรับส่งสถานะการทำงานกลับไปให้ PHP สามารถใช้เป็น IP ภายในได้

# Database ที่เก็บ cron jobs (ฝั่ง PHP)
CRON_DB_HOST=xxx         # IP ของ PHP สำหรับดึงข้อมูล Query
CRON_DB_PORT=3306        # Port ของ PHP สำหรับดึงข้อมูล Query
CRON_DB_USER=xxx         # User ของ PHP สำหรับดึงข้อมูล Query
CRON_DB_PASSWORD=xxx     # รหัสผ่านของ User PHP
CRON_DB_NAME=xxx         # ฐานข้อมูลของ PHP สำหรับดึงข้อมูล Query

API_KEY=xxx@xxx            # รหัสลับที่ต้องตรงกับที่ตั้งค่าใน PHP
API_KEY_SUMMARY=xxx@xxx    # รหัสลับที่ต้องตรงกับที่ตั้งค่าใน PHP

TELEGRAM_BOT_TOKEN=xxx     # Token สำหรับส่งการแจ้งเตือนผ่าน Telegram (ถ้ามี)
TELEGRAM_CHAT_ID=xxx       # Chat ID สำหรับส่งการแจ้งเตือนผ่าน Telegram (ถ้ามี)

MOPH_NOTIFY_URL=https://morpromt2f.moph.go.th
MOPH_CLIENT_KEY=xxx        # สำหรับส่งการแจ้งเตือนผ่าน Line Notify (ถ้ามี)
MOPH_SECRET_KEY=xxx        # สำหรับส่งการแจ้งเตือนผ่าน Line Notify (ถ้ามี)

HOSCODE=xxx         # รหัสหน่วยงาน

# =========================
# Allowed Origins (comma-separated) IP หรือ URL ที่อนุญาตให้เชื่อมต่อกับ NodeJS-Server
# =========================
ALLOWED_ORIGINS=https://website.hangchathospital.com,\
https://lookerstudio.google.com,\
http://127.0.0.1:3001,\
https://mis-health.lpho.go.th
